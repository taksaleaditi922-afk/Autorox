{
  "name": "autogarage-backend",
  "version": "1.0.0",
  "description": "AutoGarage Job Card Management System - Backend API",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "seed": "tsx src/seed/seed.ts",
    "migrate:inventory": "tsx src/migrations/20261001-inventory-upgrade.ts",
    "test": "vitest run"
  },
  "keywords": [
    "mern",
    "job-card",
    "automotive",
    "workshop",
    "autogarage"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.4",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/morgan": "^1.9.0",
    "@types/multer": "^1.4.5",
    "@types/node": "^22.10.2",
    "nodemon": "^3.1.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
