# Server
NODE_ENV=development
PORT=9014
HOST=0.0.0.0

# MongoDB: stock edits/movements require a replica set (or MongoDB Atlas).
# For a local replica set named rs0:
MONGODB_URI=mongodb://127.0.0.1:27017/autogarage?replicaSet=rs0

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_REFRESH_SECRET=change-me-refresh-secret

# Frontend origin for CORS
CLIENT_URL=http://localhost:5173

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Seeded default admin (used by npm run seed)
SEED_ADMIN_EMAIL=admin@autorox.in
SEED_ADMIN_PASSWORD=admin123
